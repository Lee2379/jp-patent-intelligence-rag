# Every component is local and free. No API key is required.
PATENT_RAG_DATA_DIR=/app/data/processed
PATENT_RAG_INDEX_DIR=/app/artifacts/index
PATENT_RAG_AUDIT_DB=/app/artifacts/audit/audit.sqlite3
# Native FastAPI process reaches the dedicated Docker container through the host port.
# Compose overrides this to http://ollama:11434 inside its private network.
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_HOST_PORT=11435
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=180
PATENT_RAG_TOP_K=4
PATENT_RAG_MIN_DENSE_SCORE=0.81
